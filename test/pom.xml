<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
   <parent>
      <groupId>org.openmrs</groupId>
      <artifactId>openmrs</artifactId>
      <version>2.5.15</version>
   </parent>
   <modelVersion>4.0.0</modelVersion>
   <groupId>org.openmrs.test</groupId>
   <artifactId>openmrs-test</artifactId>
   <packaging>pom</packaging>
   <name>openmrs-test</name>
   <description>The test dependencies for openmrs (Spring Boot 3.4.5)</description>

   <dependencies>
      <!-- Spring Boot Test: provides Spring Test, JUnit 5, Mockito, Hamcrest, AssertJ -->
      <dependency>
         <groupId>org.springframework.boot</groupId>
         <artifactId>spring-boot-starter-test</artifactId>
      </dependency>
      <!-- H2 in-memory database for tests -->
      <dependency>
         <groupId>com.h2database</groupId>
         <artifactId>h2</artifactId>
      </dependency>
      <!-- JUnit 4 vintage support (OpenMRS still has JUnit 4 tests) -->
      <dependency>
         <groupId>junit</groupId>
         <artifactId>junit</artifactId>
      </dependency>
      <dependency>
         <groupId>org.junit.vintage</groupId>
         <artifactId>junit-vintage-engine</artifactId>
      </dependency>
      <!-- DBUnit for database testing -->
      <dependency>
         <groupId>org.dbunit</groupId>
         <artifactId>dbunit</artifactId>
      </dependency>
   </dependencies>

   <build>
      <plugins>
         <plugin>
            <groupId>com.mycila</groupId>
            <artifactId>license-maven-plugin</artifactId>
            <configuration>
               <header>../license-header.txt</header>
            </configuration>
         </plugin>
      </plugins>
   </build>

</project>
